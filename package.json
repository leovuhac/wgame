{
  "name": "airplane-shooter-webgame",
  "version": "0.1.0",
  "description": "Airplane Shooter Webgame Online - Multi-platform 3D shooting game",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "nx run-many --target=dev --all --parallel",
    "build": "nx run-many --target=build --all",
    "test": "nx run-many --target=test --all",
    "lint": "nx run-many --target=lint --all",
    "format": "prettier --write \"packages/**/*.ts\" \"packages/**/*.tsx\" \"packages/**/*.json\"",
    "format:check": "prettier --check \"packages/**/*.ts\" \"packages/**/*.tsx\" \"packages/**/*.json\""
  },
  "devDependencies": {
    "@nx/workspace": "^19.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.50.0",
    "jest": "^29.5.0",
    "nx": "^19.0.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.0"
  }
}
