# Server Configuration
NODE_ENV=development
PORT=3000
HOST=localhost

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_change_in_production
JWT_EXPIRY=24h
JWT_REFRESH_EXPIRY=7d

# MongoDB Configuration
MONGO_URL=mongodb://localhost:27017/wgame
MONGO_POOL_SIZE=10

# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=wgame_user
DB_PASSWORD=secure_password
DB_NAME=wgame_financial

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_DB=0
REDIS_PASSWORD=

# Kafka Configuration (optional)
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=wgame-server

# Encryption
ENCRYPTION_KEY=your_encryption_key_32_chars_long
ENCRYPTION_IV=your_iv_16_chars

# Payment Gateway
BANK_API_KEY=
MOMO_API_KEY=
MOMO_PARTNER_CODE=
ZALOPAY_APP_ID=

# Admin Panel
ADMIN_SECRET=admin_secret_key

# Logging
LOG_LEVEL=info

# CORS
CORS_ORIGIN=http://localhost:3001,http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
