{
  "name": "@wgame/shared",
  "version": "0.1.0",
  "description": "Shared types and utilities for Airplane Shooter Webgame",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./types": {
      "import": "./dist/types/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./events": {
      "import": "./dist/types/events.js",
      "types": "./dist/types/events.d.ts"
    },
    "./api": {
      "import": "./dist/types/api.js",
      "types": "./dist/types/api.d.ts"
    }
  },
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc",
    "test": "jest",
    "lint": "eslint src --ext .ts"
  },
  "private": true,
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.0"
  }
}
